# Story Generation
# Wähle einen Provider: openai oder claude
STORY_PROVIDER=openai

# OpenAI API Key (für Story-Generierung mit GPT-4o-mini oder GPT-4)
OPENAI_API_KEY=sk-...

# Claude API Key (Alternative zu OpenAI)
CLAUDE_API_KEY=sk-ant-...

# Voice Generation
# Wähle einen Provider: elevenlabs oder gtts (kostenlos, schlechtere Qualität)
VOICE_PROVIDER=elevenlabs

# ElevenLabs API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=...

# Zukünftig: TikTok Upload (Version 2)
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
